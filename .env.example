# ToDoch – Konfiguration
#
# Kopieren nach deploy/.env (Docker Compose) bzw. /etc/todoch/todoch.env (Proxmox-LXC,
# erledigt der Installer automatisch). Die Datei enthält Geheimnisse: chmod 600, nie committen.
# ToDoch startet nicht, solange hier Platzhalter stehen.
#
# Secrets erzeugen:
#   openssl rand -hex 24      → Passwörter
#   openssl rand -hex 32      → TODOCH_SECRET_KEY
#   openssl rand -base64 32   → Schlüssel für TODOCH_ENCRYPTION_KEYS

# --- Adresse ------------------------------------------------------------------------------
# Öffentliche Adresse genau so, wie sie im Browser steht. Passkeys sind an diesen Hostnamen
# gebunden – nie eine IP verwenden.
TODOCH_ORIGIN=https://todoch.example.de
# Hostname ohne https:// (für Caddy)
TODOCH_DOMAIN=todoch.example.de
# proxy    = HTTPS macht ein vorgelagerter Reverse-Proxy (NetBird, NPM, Traefik); ToDoch nur HTTP :80
# internal = HTTPS mit eigener ToDoch-CA (Heimnetz); Zertifikat unter http://<IP>/ca.crt
# acme     = HTTPS mit Let's Encrypt (DNS zeigt auf diesen Server, Ports 80/443 offen)
TODOCH_TLS_MODE=internal
# Nur bei „proxy“: wer die Client-IP mitteilen darf (Standard: privates Netz). Genauer ist die
# IP des Proxys, z. B. 192.168.178.20 – mehrere mit Leerzeichen getrennt. Befehl: todoch proxy-ip
# TODOCH_TRUSTED_PROXIES=private_ranges
# Ports auf dem Host
TODOCH_HTTP_PORT=80
TODOCH_HTTPS_PORT=443

# --- Geheimnisse --------------------------------------------------------------------------
# Signatur-Schlüssel (mind. 32 Zeichen), z. B. für Feed-Links
TODOCH_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
# Schlüssel für die Verschlüsselung von Mail-Passwörtern und OAuth-Tokens (AES-256-GCM).
# Format „ID:Base64“, mehrere durch Komma. Neue Chiffrate nutzen den höchsten Schlüssel
# (oder TODOCH_ENCRYPTION_KEY_ACTIVE). Rotation: siehe docs/SECURITY.md.
# OHNE DIESEN SCHLÜSSEL SIND GESPEICHERTE ZUGANGSDATEN NICHT WIEDERHERSTELLBAR – getrennt sichern!
TODOCH_ENCRYPTION_KEYS=1:CHANGE_ME_openssl_rand_base64_32
# Einmaliger Code für die Ersteinrichtung des Admin-Kontos
TODOCH_SETUP_TOKEN=CHANGE_ME_openssl_rand_hex_12
# Datenbank und Redis (nur im internen Docker-Netz erreichbar)
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
REDIS_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# --- Sitzungen ----------------------------------------------------------------------------
# Abmeldung nach Inaktivität (Minuten) und spätestens nach (Stunden)
TODOCH_SESSION_IDLE_MINUTES=720
TODOCH_SESSION_ABSOLUTE_HOURS=168

# --- Mit Google/Microsoft verbinden (optional) -------------------------------------------
# Für die Knöpfe „Mit Google verbinden“ / „Mit Microsoft verbinden“ unter E-Mail. Im
# Proxmox-LXC am einfachsten mit „todoch oauth google“ bzw. „todoch oauth microsoft“ – der
# Befehl zeigt die Rücksprungadresse (TODOCH_ORIGIN/api/mail/oauth/<anbieter>/callback).
# TODOCH_GOOGLE_CLIENT_ID=
# TODOCH_GOOGLE_CLIENT_SECRET=
# TODOCH_MICROSOFT_CLIENT_ID=
# TODOCH_MICROSOFT_CLIENT_SECRET=
# Nur für Firmenkonten eines bestimmten Mandanten ändern (Standard: common)
# TODOCH_MICROSOFT_TENANT=common

# --- Sonstiges ----------------------------------------------------------------------------
TODOCH_ENVIRONMENT=production
TODOCH_LOG_LEVEL=info
TZ=Europe/Berlin
# Installierte Version (setzt der Befehl „update“)
TODOCH_VERSION=latest
# Pfad dieser Datei für Docker Compose (nur ändern, wenn sie woanders liegt)
TODOCH_ENV_FILE=.env
