  "components": {
    "schemas": {
      "AreaIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Name"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "title": "Color",
            "default": "#6b7280"
          },
          "icon": {
            "type": "string",
            "enum": [
              "circle",
              "briefcase",
              "home",
              "heart",
              "star",
              "book",
              "users",
              "cart",
              "car",
              "dumbbell",
              "music",
              "leaf",
              "code",
              "wallet",
              "plane",
              "school"
            ],
            "title": "Icon",
            "default": "circle"
          },
          "sort_order": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Sort Order",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AreaIn"
      },
      "AreaOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "color": {
            "type": "string",
            "title": "Color"
          },
          "icon": {
            "type": "string",
            "title": "Icon"
          },
          "sort_order": {
            "type": "integer",
            "title": "Sort Order"
          },
          "open_count": {
            "type": "integer",
            "title": "Open Count"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "color",
          "icon",
          "sort_order",
          "open_count",
          "role"
        ],
        "title": "AreaOut"
      },
      "AreaPatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "color": {
            "anyOf": [
