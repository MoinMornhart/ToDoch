# Hinter einem Reverse-Proxy (NetBird, Nginx Proxy Manager, Traefik …):
# ToDoch spricht nur HTTP auf Port 80, HTTPS und Zertifikat übernimmt der Proxy.
{
	admin off
	auto_https off
	servers {
		# Nur diese Absender dürfen die Client-IP mitteilen (TODOCH_TRUSTED_PROXIES, z. B. die IP des
		# Proxys). Gelesen wird von rechts: vorangestellte, gefälschte Einträge zählen nicht.
		trusted_proxies static {$TODOCH_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

import /etc/caddy/todoch.caddy

:80 {
	import todoch
}
